{
  "colors": {
    "forest-900": "#083A0B",
    "forest-800": "#0E4A14",
    "forest-700": "#0F5F1A",
    "forest-600": "#15803D",
    "forest-100": "#DDEFE0",
    "forest-50": "#F0FAF2",
    "volt-400": "#FAE104",
    "amber-500": "#F89920",
    "paper": "#F7F6F0",
    "white": "#FFFFFF",
    "ink-900": "#111827",
    "ink-700": "#374151",
    "ink-600": "#4B5563",
    "ink-300": "#D1D5DB",
    "ink-200": "#E5E7EB",
    "mist-200": "#C9DCCB",
    "error-700": "#B91C1C"
  },
  "contrast": [
    ["white", "forest-900", 4.5, "Body text on dark"],
    ["mist-200", "forest-900", 4.5, "Muted text on dark"],
    ["volt-400", "forest-900", 4.5, "Accent and links on dark"],
    ["forest-900", "volt-400", 4.5, "Primary button on dark"],
    ["ink-900", "white", 4.5, "Body text on white"],
    ["ink-900", "paper", 4.5, "Body text on paper"],
    ["ink-600", "white", 4.5, "Muted text on white"],
    ["ink-600", "paper", 4.5, "Muted text on paper"],
    ["white", "forest-700", 4.5, "Primary button on light"],
    ["forest-700", "white", 4.5, "Links on white"],
    ["forest-700", "paper", 4.5, "Links on paper"],
    ["forest-700", "forest-100", 4.5, "Badge text"],
    ["error-700", "white", 4.5, "Error text on white"],
    ["forest-700", "white", 3, "Focus ring on light (non-text)"],
    ["volt-400", "forest-900", 3, "Focus ring on dark (non-text)"],
    ["ink-600", "white", 3, "Form field border (non-text)"]
  ],
  "fontFamily": {
    "sans": "\"Source Sans 3\", \"Source Sans 3 Fallback\", system-ui, sans-serif"
  },
  "type": {
    "minViewport": 360,
    "maxViewport": 1440,
    "minBase": 17,
    "maxBase": 19,
    "minRatio": 1.2,
    "maxRatio": 1.25,
    "steps": { "sm": -1, "base": 0, "lg": 1, "xl": 2, "2xl": 3, "3xl": 4, "4xl": 5, "5xl": 6 }
  },
  "lineHeight": { "tight": "1.1", "snug": "1.25", "body": "1.6" },
  "weight": { "light": "300", "regular": "400", "semibold": "600", "bold": "700" },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem",
    "9": "6rem",
    "10": "8rem"
  },
  "fluidSpacing": {
    "gutter": [1, 2],
    "block": [2, 4],
    "section": [4, 8]
  },
  "container": { "narrow": "48rem", "default": "75rem", "wide": "90rem" },
  "radius": { "sm": "0.25rem", "md": "0.5rem", "lg": "1rem", "pill": "9999px" },
  "shadow": {
    "sm": "0 1px 2px rgb(8 58 11 / 0.08)",
    "md": "0 4px 12px rgb(8 58 11 / 0.1)",
    "lg": "0 16px 40px rgb(8 58 11 / 0.16)"
  },
  "breakpoints": { "sm": "40rem", "md": "48rem", "lg": "64rem", "xl": "80rem" },
  "motion": {
    "duration": { "fast": "150ms", "base": "250ms", "slow": "500ms" },
    "ease": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "distance": { "sm": "12px", "md": "24px", "lg": "48px" }
  }
}
