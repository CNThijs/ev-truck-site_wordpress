			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "sm",
					"shadow": "0 1px 2px rgb(8 58 11 / 0.08)"
				},
				{
					"slug": "md",
					"name": "md",
					"shadow": "0 4px 12px rgb(8 58 11 / 0.1)"
				},
				{
					"slug": "lg",
					"name": "lg",
					"shadow": "0 16px 40px rgb(8 58 11 / 0.16)"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "0.25rem",
				"md": "0.5rem",
				"lg": "1rem",
				"pill": "9999px"
			},
			"duration": {
				"fast": "150ms",
				"base": "250ms",
				"slow": "500ms"
			},
			"ease": {
				"out": "cubic-bezier(0.22, 1, 0.36, 1)",
				"in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
			},
			"distance": {
				"sm": "12px",
				"md": "24px",
				"lg": "48px"
			},
			"breakpoint": {
				"sm": "40rem",
				"md": "48rem",
				"lg": "64rem",
				"xl": "80rem"
			}
		}
