msgid "One step: a title and a short text or list."
msgstr "Eén stap: een titel en een korte tekst of lijst."

#: blocks/steps/block.json build/blocks/steps/block.json
msgctxt "block title"
msgid "Steps"
msgstr "Stappen"

#: blocks/steps/block.json build/blocks/steps/block.json
msgctxt "block description"
msgid ""
"A numbered process. Variants: horizontal (side by side on wide screens) and "
"vertical (a timeline down the page)."
msgstr ""
"Een genummerd proces. Varianten: horizontaal (naast elkaar op brede "
"schermen) en verticaal (een tijdlijn over de pagina)."

