{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/feature-columns",
  "title": "Feature Columns",
  "category": "chargenet-sections",
  "icon": "columns",
  "description": "Two or three columns, each with a title, sub-headings with bullet lists and a link. For audience comparisons such as location owners and fleet managers.",
  "keywords": ["columns", "audience", "benefits", "lists", "comparison"],
  "textdomain": "chargenet",
  "attributes": {
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "headingLevel": { "type": "number", "default": 2 },
    "intro": { "type": "string", "default": "" }
  },
  "providesContext": { "chargenet/headingLevel": "headingLevel" },
  "supports": { "anchor": true, "html": false, "align": false, "customClassName": false },
  "example": {
    "attributes": {
      "sectionBackground": "paper",
      "heading": "Built for both sides of the network"
    },
    "innerBlocks": [
      {
        "name": "chargenet/feature-column",
        "attributes": {
          "title": "Location owners",
          "linkLabel": "Explore location benefits",
          "url": "#"
        },
        "innerBlocks": [
          {
            "name": "core/list",
            "innerBlocks": [
              { "name": "core/list-item", "attributes": { "content": "Earn on idle capacity" } }
            ]
          }
        ]
      },
      {
        "name": "chargenet/feature-column",
        "attributes": {
          "title": "Fleet managers",
          "linkLabel": "Explore carrier benefits",
          "url": "#"
        },
        "innerBlocks": [
          {
            "name": "core/list",
            "innerBlocks": [
              { "name": "core/list-item", "attributes": { "content": "Charge where you stop" } }
            ]
          }
        ]
      }
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
