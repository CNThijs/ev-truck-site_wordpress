{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/logo-strip",
  "title": "Logo Strip",
  "category": "chargenet-sections",
  "icon": "images-alt2",
  "description": "A row of partner, funder or customer logos, each optionally linked. Variants: grayscale and colour.",
  "keywords": ["logos", "partners", "clients", "funders", "brands"],
  "textdomain": "chargenet",
  "attributes": {
    "variant": { "type": "string", "enum": ["grayscale", "colour"], "default": "grayscale" },
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "headingLevel": { "type": "number", "default": 2 },
    "intro": { "type": "string", "default": "" }
  },
  "supports": { "anchor": true, "html": false, "align": false, "customClassName": false },
  "example": {
    "attributes": { "heading": "Our partners" },
    "innerBlocks": [
      { "name": "chargenet/logo-item", "attributes": { "name": "Partner one" } },
      { "name": "chargenet/logo-item", "attributes": { "name": "Partner two" } }
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
