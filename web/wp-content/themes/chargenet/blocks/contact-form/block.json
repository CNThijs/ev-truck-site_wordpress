{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/contact-form",
  "title": "Contact form",
  "category": "chargenet-sections",
  "icon": "email",
  "description": "A contact form (name, email, message, consent). Every message is stored and emailed to the team; the visitor gets a copy. Works without JavaScript.",
  "keywords": ["form", "contact", "email"],
  "textdomain": "chargenet",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    },
    "intro": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": false,
    "customClassName": false
  },
  "example": {
    "attributes": {
      "heading": "Contact form"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js"
}
