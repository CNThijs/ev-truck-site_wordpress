{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/newsletter-signup",
  "title": "Newsletter sign-up",
  "category": "chargenet-sections",
  "icon": "email",
  "description": "Newsletter sign-up (email and consent). Subscriptions are stored in WordPress (Form submissions) until a newsletter platform is connected. Works without JavaScript.",
  "keywords": ["newsletter", "subscribe", "email", "form"],
  "textdomain": "chargenet",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    },
    "intro": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": false,
    "customClassName": false
  },
  "example": {
    "attributes": {
      "heading": "Contact form"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js"
}
