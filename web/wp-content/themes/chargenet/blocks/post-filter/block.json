{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/post-filter",
  "title": "News filter",
  "category": "chargenet-sections",
  "icon": "filter",
  "description": "Category links and a search box for the news. Works without JavaScript.",
  "keywords": ["news", "categories", "search", "filter"],
  "textdomain": "chargenet",
  "attributes": {
    "showCategories": {
      "type": "boolean",
      "default": true
    },
    "showSearch": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": false,
    "customClassName": false
  },
  "example": {
    "attributes": {}
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
