{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/feature-grid-item",
  "title": "Feature Item",
  "category": "chargenet-sections",
  "parent": ["chargenet/feature-grid"],
  "icon": "star-filled",
  "description": "One item of a feature grid: icon, title, text and an optional link.",
  "textdomain": "chargenet",
  "attributes": {
    "icon": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "text": { "type": "string", "default": "" },
    "url": { "type": "string", "default": "" },
    "linkLabel": { "type": "string", "default": "" }
  },
  "usesContext": ["chargenet/headingLevel", "chargenet/gridVariant"],
  "supports": { "html": false, "reusable": false, "customClassName": false },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
