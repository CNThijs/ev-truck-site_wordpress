{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chargenet/team",
  "title": "Team",
  "category": "chargenet-sections",
  "icon": "groups",
  "description": "People with photo, name, role and contact links. Variants: cards (portrait photos) and compact (small round photos, for contact cards).",
  "keywords": ["team", "people", "contact", "staff", "advisors"],
  "textdomain": "chargenet",
  "attributes": {
    "variant": { "type": "string", "enum": ["cards", "compact"], "default": "cards" },
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "headingLevel": { "type": "number", "default": 2 },
    "intro": { "type": "string", "default": "" }
  },
  "providesContext": {
    "chargenet/headingLevel": "headingLevel",
    "chargenet/teamVariant": "variant"
  },
  "supports": { "anchor": true, "html": false, "align": false, "customClassName": false },
  "example": {
    "attributes": { "sectionBackground": "paper", "heading": "Our team" },
    "innerBlocks": [
      { "name": "chargenet/team-member", "attributes": { "name": "Alex Example", "role": "CEO" } },
      { "name": "chargenet/team-member", "attributes": { "name": "Sam Sample", "role": "CTO" } }
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
