<?xml version="1.0"?>
<ruleset name="ChargeNet">
	<description>WordPress Coding Standards for the chargenet theme.</description>

	<file>web/wp-content/themes/chargenet</file>
	<exclude-pattern>*/assets/dist/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>

	<!-- PHP 8.2 and up. -->
	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.6"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="chargenet"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="chargenet"/>
			</property>
		</properties>
	</rule>
</ruleset>
