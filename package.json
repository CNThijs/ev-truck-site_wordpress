{
  "name": "chargenet-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run tokens && concurrently -n vite,blocks \"vite\" \"npm run dev:blocks\"",
    "build": "npm run tokens && npm run build:blocks && vite build",
    "lint": "npm run lint:php && npm run lint:js && npm run lint:css && npm run format:check",
    "lint:php": "vendor/bin/phpcs",
    "lint:js": "eslint web/wp-content/themes/chargenet/assets/src web/wp-content/themes/chargenet/blocks bin/*.mjs tests playwright.config.mjs vite.config.js eslint.config.js",
    "lint:css": "stylelint \"web/wp-content/themes/chargenet/assets/src/**/*.scss\" \"web/wp-content/themes/chargenet/blocks/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash bin/package.sh",
    "prepare": "git config core.hooksPath .githooks",
    "i18n": "ddev wp i18n make-pot web/wp-content/themes/chargenet web/wp-content/themes/chargenet/languages/chargenet.pot --domain=chargenet",
    "tokens": "node bin/build-tokens.mjs",
    "make:section": "node bin/make-section.mjs",
    "dev:blocks": "wp-scripts start --webpack-src-dir=web/wp-content/themes/chargenet/blocks --output-path=web/wp-content/themes/chargenet/build/blocks --webpack-copy-php --experimental-modules",
    "build:blocks": "wp-scripts build --webpack-src-dir=web/wp-content/themes/chargenet/blocks --output-path=web/wp-content/themes/chargenet/build/blocks --webpack-copy-php --experimental-modules",
    "translations": "node bin/build-translations.mjs",
    "check:hreflang": "node bin/check-hreflang.mjs",
    "check:seo": "node bin/check-seo.mjs",
    "check:redirects": "node bin/check-redirects.mjs",
    "perf": "node bin/perf.mjs",
    "check:budget": "node bin/check-budget.mjs",
    "test:forms": "ddev wp eval-file bin/test-forms.php",
    "test:blog": "ddev wp eval-file bin/test-blog.php",
    "check:blog-urls": "node bin/check-blog-urls.mjs",
    "check:security": "node bin/check-security.mjs",
    "check:a11y": "node bin/check-a11y.mjs",
    "check:hardening": "ddev wp eval-file bin/check-hardening.php",
    "test:e2e": "playwright test --grep-invert \"visual \" --project=\"chromium-*\" --project=\"webkit-*\"",
    "test:e2e:visual": "playwright test visual.spec.mjs --project=chromium-mobile --project=chromium-tablet --project=chromium-desktop",
    "test:redirect-rules": "bash bin/test-redirect-rules.sh",
    "build:redirects-htaccess": "node bin/build-redirects-htaccess.mjs",
    "test:e2e:all": "playwright test --grep-invert \"visual \"",
    "package:setup": "bash bin/package-setup.sh",
    "test:maintenance-gate": "bash bin/test-maintenance-gate.sh"
  },
  "lint-staged": {
    "*.php": "vendor/bin/phpcs",
    "*.js": [
      "eslint",
      "prettier --check"
    ],
    "*.scss": [
      "stylelint",
      "prettier --check"
    ],
    "*.{json,yml,md}": "prettier --check"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@wordpress/scripts": "^36.0.0",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.13.0",
    "sass": "^1.105.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.1"
  },
  "version": "1.0.0",
  "description": "WordPress with a custom theme (`chargenet`). See `CLAUDE.md` for the full project context and commands.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNThijs/ev-truck-site_wordpress.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CNThijs/ev-truck-site_wordpress/issues"
  },
  "homepage": "https://github.com/CNThijs/ev-truck-site_wordpress#readme"
}
