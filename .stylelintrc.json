{
  "extends": "stylelint-config-standard-scss",
  "ignoreFiles": [
    "**/dist/**",
    "vendor/**",
    "node_modules/**",
    "**/_tokens.generated.scss",
    "**/_breakpoints.generated.scss"
  ],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Use BEM kebab-case class names"
      }
    ]
  }
}
